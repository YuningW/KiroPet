{
  "name": "thaidevpet",
  "displayName": "ThaiDevPet",
  "description": "ThaiDevPet: a cute GMMTV buddy (cartoon or pixel) that hangs out in your editor, teaches Thai words by level and scene, and visits Thai landmarks, festivals and parties.",
  "version": "0.7.1",
  "publisher": "yuningw",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "pet",
    "thai",
    "vocabulary",
    "kiro",
    "gmmtv"
  ],
  "icon": "media/icon.png",
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "thaidevpet.view",
          "name": "ThaiDevPet",
          "when": "thaidevpet.panelOn"
        }
      ]
    },
    "commands": [
      {
        "command": "thaidevpet.hideWord",
        "title": "Hide Thai word card",
        "category": "ThaiDevPet",
        "icon": "$(eye)"
      },
      {
        "command": "thaidevpet.showWord",
        "title": "Show Thai word card",
        "category": "ThaiDevPet",
        "icon": "$(eye-closed)"
      },
      {
        "command": "thaidevpet.toggleWord",
        "title": "Show / hide Thai word card",
        "category": "ThaiDevPet"
      },
      {
        "command": "thaidevpet.choosePet",
        "title": "Choose pet (panel / screen / both)…",
        "category": "ThaiDevPet",
        "icon": "$(heart)"
      },
      {
        "command": "thaidevpet.startScreenPet",
        "title": "Start screen pet (walks around the window)",
        "category": "ThaiDevPet"
      },
      {
        "command": "thaidevpet.stopScreenPet",
        "title": "Stop screen pet",
        "category": "ThaiDevPet"
      },
      {
        "command": "thaidevpet.nextWord",
        "title": "Next Thai word",
        "category": "ThaiDevPet",
        "icon": "$(refresh)"
      },
      {
        "command": "thaidevpet.chooseLevel",
        "title": "Choose Thai level",
        "category": "ThaiDevPet",
        "icon": "$(mortar-board)"
      },
      {
        "command": "thaidevpet.changeBuddy",
        "title": "Change buddy",
        "category": "ThaiDevPet",
        "icon": "$(heart)"
      },
      {
        "command": "thaidevpet.chooseScene",
        "title": "Background…",
        "category": "ThaiDevPet",
        "icon": "$(paintcan)"
      },
      {
        "command": "thaidevpet.partyBuddies",
        "title": "Party buddies…",
        "category": "ThaiDevPet",
        "icon": "$(person-add)"
      },
      {
        "command": "thaidevpet.timer",
        "title": "Timer / alarm…",
        "category": "ThaiDevPet",
        "icon": "$(watch)"
      },
      {
        "command": "thaidevpet.breakReminder",
        "title": "Break reminder…",
        "category": "ThaiDevPet",
        "icon": "$(coffee)"
      },
      {
        "command": "thaidevpet.activity",
        "title": "Do an activity…",
        "category": "ThaiDevPet",
        "icon": "$(sparkle)"
      },
      {
        "command": "thaidevpet.toggleStyle",
        "title": "Switch art style (pixel / cartoon)",
        "category": "ThaiDevPet",
        "icon": "$(color-mode)"
      },
      {
        "command": "thaidevpet.show",
        "title": "Show pet",
        "category": "ThaiDevPet"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "thaidevpet.hideWord",
          "when": "view == thaidevpet.view && thaidevpet.wordOn",
          "group": "navigation@0"
        },
        {
          "command": "thaidevpet.showWord",
          "when": "view == thaidevpet.view && !thaidevpet.wordOn",
          "group": "navigation@0"
        },
        {
          "command": "thaidevpet.timer",
          "when": "view == thaidevpet.view",
          "group": "navigation@0"
        },
        {
          "command": "thaidevpet.nextWord",
          "when": "view == thaidevpet.view",
          "group": "navigation@1"
        },
        {
          "command": "thaidevpet.chooseLevel",
          "when": "view == thaidevpet.view",
          "group": "navigation@2"
        },
        {
          "command": "thaidevpet.changeBuddy",
          "when": "view == thaidevpet.view",
          "group": "navigation@3"
        },
        {
          "command": "thaidevpet.chooseScene",
          "when": "view == thaidevpet.view",
          "group": "navigation@3"
        },
        {
          "command": "thaidevpet.toggleStyle",
          "when": "view == thaidevpet.view",
          "group": "navigation@4"
        }
      ],
      "webview/context": [
        {
          "command": "thaidevpet.changeBuddy",
          "when": "webviewId == 'thaidevpet.view'",
          "group": "thaidevpet@1"
        },
        {
          "command": "thaidevpet.toggleStyle",
          "when": "webviewId == 'thaidevpet.view'",
          "group": "thaidevpet@2"
        },
        {
          "command": "thaidevpet.chooseScene",
          "when": "webviewId == 'thaidevpet.view'",
          "group": "thaidevpet@2"
        },
        {
          "command": "thaidevpet.partyBuddies",
          "when": "webviewId == 'thaidevpet.view'",
          "group": "thaidevpet@2"
        },
        {
          "command": "thaidevpet.chooseLevel",
          "when": "webviewId == 'thaidevpet.view'",
          "group": "thaidevpet@3"
        },
        {
          "command": "thaidevpet.toggleWord",
          "when": "webviewId == 'thaidevpet.view'",
          "group": "thaidevpet@4"
        },
        {
          "command": "thaidevpet.nextWord",
          "when": "webviewId == 'thaidevpet.view'",
          "group": "thaidevpet@4"
        },
        {
          "command": "thaidevpet.activity",
          "when": "webviewId == 'thaidevpet.view'",
          "group": "thaidevpet@5"
        },
        {
          "command": "thaidevpet.timer",
          "when": "webviewId == 'thaidevpet.view'",
          "group": "timers@1"
        },
        {
          "command": "thaidevpet.breakReminder",
          "when": "webviewId == 'thaidevpet.view'",
          "group": "timers@2"
        }
      ]
    },
    "configuration": {
      "title": "ThaiDevPet",
      "properties": {
        "thaidevpet.startup": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "panel",
            "screen",
            "both",
            "none"
          ],
          "enumDescriptions": [
            "Ask which pet to start each time the editor opens",
            "Always start the panel pet",
            "Always start the screen pet (walks around the window, Windows only)",
            "Always start both",
            "Start no pet"
          ],
          "description": "Which pet starts when the editor opens. Nothing starts on its own unless you pick it here."
        },
        "thaidevpet.mascot": {
          "type": "string",
          "default": "muvmuv",
          "enum": [
            "muvmuv",
            "lunar",
            "any",
            "jewel",
            "vimmy",
            "wesley",
            "goldie_red",
            "goldie_brown",
            "lolo"
          ],
          "enumItemLabels": [
            "MuvMuv",
            "Lunar",
            "Any",
            "Jewel",
            "Vimmy",
            "Wesley",
            "Goldie (red)",
            "Goldie (brown)",
            "LOLO"
          ],
          "description": "Which buddy walks around."
        },
        "thaidevpet.style": {
          "type": "string",
          "default": "cartoon",
          "enum": [
            "cartoon",
            "pixel"
          ],
          "enumDescriptions": [
            "Smooth cartoon drawing",
            "Retro pixel art"
          ],
          "description": "Art style for the buddy."
        },
        "thaidevpet.scene": {
          "type": "string",
          "default": "shuffle:everyday",
          "enum": [
            "shuffle:everyday",
            "office",
            "cafe",
            "bedroom",
            "rainy",
            "shuffle:thailand",
            "wat_arun",
            "market",
            "beach",
            "yaowarat",
            "tuktuk",
            "shuffle:festivals",
            "songkran",
            "loykrathong",
            "shuffle:party",
            "stage",
            "party",
            "bar",
            "shuffle",
            "none"
          ],
          "enumItemLabels": [
            "Shuffle: Everyday",
            "Everyday · Office",
            "Everyday · Café",
            "Everyday · Bedroom",
            "Everyday · Rainy day",
            "Shuffle: Thailand",
            "Thailand · Wat Arun",
            "Thailand · Floating market",
            "Thailand · Krabi beach",
            "Thailand · Yaowarat",
            "Thailand · Tuk-tuk street",
            "Shuffle: Festivals",
            "Festivals · Songkran",
            "Festivals · Loy Krathong",
            "Shuffle: Party",
            "Party · SAMTUABAHT Fanmeet",
            "Party · Dance party",
            "Party · Rooftop bar",
            "Shuffle everything",
            "No background"
          ],
          "markdownDescription": "Background behind the panel pet: one scene, a shuffle within a category, or none. Default shuffles **Everyday** (office, café, bedroom, rainy day)."
        },
        "thaidevpet.sceneShuffleMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 480,
          "description": "When shuffling, switch to another scene every N minutes (0 = only when the editor opens)."
        },
        "thaidevpet.sceneStrength": {
          "type": "string",
          "default": "full",
          "enum": [
            "full",
            "soft"
          ],
          "enumDescriptions": [
            "Scene in full colour",
            "Scene faded into your editor theme"
          ],
          "description": "How strong the background is."
        },
        "thaidevpet.sceneWords": {
          "type": "boolean",
          "default": true,
          "description": "Mix in Thai words that go with the current scene."
        },
        "thaidevpet.partyBuddies": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "enum": [
              "muvmuv",
              "lunar",
              "any",
              "jewel",
              "vimmy",
              "wesley",
              "goldie_red",
              "goldie_brown",
              "lolo"
            ]
          },
          "maxItems": 2,
          "description": "Who joins your buddy on the stage / at the party (empty = random friends)."
        },
        "thaidevpet.thaiLevel": {
          "type": "string",
          "default": "beginner",
          "enum": [
            "beginner",
            "elementary",
            "intermediate",
            "advanced",
            "all"
          ],
          "enumDescriptions": [
            "Survival basics: greetings, numbers, pronouns, core verbs",
            "Everyday life: family, food, time, places, feelings",
            "Connecting ideas: linking words, particles, classifiers, work & study",
            "News & formal Thai: government, economy, formal verbs, idioms",
            "Every level mixed together"
          ],
          "description": "Which Thai vocabulary level the buddy teaches."
        },
        "thaidevpet.wordIntervalMinutes": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 120,
          "description": "Show a new Thai word every N minutes while the editor is focused (click the card for the next one any time)."
        },
        "thaidevpet.showWord": {
          "type": "boolean",
          "default": true,
          "description": "Show the Thai word card at the top of the panel (it changes word on its own every few minutes)."
        },
        "thaidevpet.quizMode": {
          "type": "boolean",
          "default": false,
          "description": "Hide the English meaning until you click the speech bubble."
        },
        "thaidevpet.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Also show the current Thai word in the status bar."
        },
        "thaidevpet.activities": {
          "type": "boolean",
          "default": true,
          "description": "Let the buddy stop now and then for little activities (coffee, music, games…)."
        },
        "thaidevpet.activityEveryMinutes": {
          "type": "number",
          "default": 2,
          "minimum": 0.5,
          "maximum": 30,
          "description": "How often the buddy starts a new activity, in minutes (each lasts 20-30 seconds). Every scene has its own activities, and each one shows its Thai word."
        },
        "thaidevpet.breakReminderMinutes": {
          "type": "number",
          "default": 60,
          "enum": [
            0,
            30,
            45,
            60,
            90
          ],
          "enumItemLabels": [
            "Off",
            "30 min",
            "45 min",
            "60 min",
            "90 min"
          ],
          "description": "Remind you to take a break after this much work. 0 turns it off."
        },
        "thaidevpet.breakResetMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Being away from the editor this long counts as a break and resets the work timer."
        },
        "thaidevpet.screenPet.script": {
          "type": "string",
          "default": "",
          "description": "Path to kiro_pet.py for the screen pet. Left empty, ThaiDevPet looks in the open folder or asks you once."
        },
        "thaidevpet.screenPet.python": {
          "type": "string",
          "default": "",
          "description": "Python used to run the screen pet. Empty = pythonw on PATH. Example: C:\\Users\\you\\AppData\\Local\\Programs\\Python\\Python313\\pythonw.exe"
        }
      }
    }
  }
}
